<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Y51Send" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_obsidian</item>
        <item name="android:statusBarColor">@color/bg_obsidian</item>
        <item name="android:navigationBarColor">@color/bg_obsidian</item>
        <item name="colorAccent">@color/accent_fine_vision</item>
    </style>

    <style name="Theme.Y51SendOverlay" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#343D74" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1.2dp"
                android:color="#A8B0FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#1A2044"
                android:startColor="#2C356A"
                android:type="linear" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#889EA6FF" />
        </shape>
    </item>
</selector>

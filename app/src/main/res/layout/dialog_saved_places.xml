<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panelSavedPlaces"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="2dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:background="@color/accent_fine_vision" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:text="@string/places_dialog_title"
            android:textAllCaps="true"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnPlacesCancel"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_button_instrument"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/voice_btn_close"
            android:textAllCaps="true"
            android:textColor="@color/text_primary"
            android:textSize="10sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="@color/glass_divider" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.12"
        android:text="@string/places_home_label"
        android:textAllCaps="true"
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />

    <EditText
        android:id="@+id/etHomeAddress"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_button_instrument"
        android:hint="@string/places_home_hint"
        android:imeOptions="actionNext"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.12"
        android:text="@string/places_work_label"
        android:textAllCaps="true"
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />

    <EditText
        android:id="@+id/etWorkAddress"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_button_instrument"
        android:hint="@string/places_work_hint"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/btnPlacesSave"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_button_accent"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:letterSpacing="0.14"
        android:text="@string/places_save"
        android:textAllCaps="true"
        android:textColor="@color/text_primary"
        android:textSize="11sp" />
</LinearLayout>

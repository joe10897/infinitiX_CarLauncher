<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tileDrawerApp"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:background="@drawable/bg_button_instrument">

    <View
        android:id="@+id/viewDrawerPinBadge"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="7dp"
        android:background="@drawable/indicator_active"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:id="@+id/ivDrawerAppIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginBottom="6dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvDrawerAppLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>

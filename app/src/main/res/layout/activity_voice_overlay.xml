<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voiceOverlayBackdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/panelVoiceRouter"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_panel"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="2dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:background="@color/accent_fine_vision" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/voice_overlay_title"
                android:src="@drawable/ic_voice_mic" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:text="@string/voice_overlay_title"
                android:textAllCaps="true"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvVoiceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.14"
                android:maxLines="1"
                android:text="@string/voice_status_listening"
                android:textAllCaps="true"
                android:textColor="@color/accent_fine_vision"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnVoiceBindSwc"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_button_instrument"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.10"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/voice_btn_bind_swc"
                android:textAllCaps="true"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btnVoiceClose"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_button_instrument"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/voice_btn_close"
                android:textAllCaps="true"
                android:textColor="@color/text_primary"
                android:textSize="10sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="14dp"
            android:background="@color/glass_divider" />

        <!-- Live Transcript -->
        <TextView
            android:id="@+id/tvVoiceTranscript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:minHeight="60dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/voice_prompt_ready"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvVoiceHints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:text="@string/voice_hints"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:background="@color/glass_divider" />

        <!-- Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnVoiceRetry"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_accent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/voice_btn_retry"
                    android:src="@drawable/ic_voice_mic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.12"
                    android:maxLines="1"
                    android:text="@string/voice_btn_retry"
                    android:textAllCaps="true"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnVoiceAssistant"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_button_instrument"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:text="@string/voice_btn_assistant"
                android:textAllCaps="true"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
